{
  "openapi": "3.0.0",
  "info": {
    "version": "0.1.0",
    "title": "matsu BFF API",
    "description": "Browser-facing API contract for the matsu application."
  },
  "servers": [
    {
      "url": "http://localhost:18082",
      "description": "Local development"
    }
  ],
  "tags": [
    {
      "name": "System"
    },
    {
      "name": "Authentication"
    },
    {
      "name": "Expenses"
    },
    {
      "name": "Expense masters"
    }
  ],
  "components": {
    "securitySchemes": {
      "SessionCookie": {
        "type": "apiKey",
        "in": "cookie",
        "name": "matsu-session",
        "description": "HttpOnly browser session cookie managed by the BFF."
      }
    },
    "schemas": {
      "HealthResponse": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "enum": ["ok"]
          }
        },
        "required": ["status"]
      },
      "AuthenticatedResponse": {
        "type": "object",
        "properties": {
          "authenticated": {
            "type": "boolean",
            "enum": [true]
          }
        },
        "required": ["authenticated"]
      },
      "ErrorResponse": {
        "type": "object",
        "properties": {
          "message": {
            "type": "string"
          }
        },
        "required": ["message"]
      },
      "ValidationErrorResponse": {
        "type": "object",
        "properties": {
          "message": {
            "type": "string"
          },
          "issues": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ValidationIssue"
            }
          }
        },
        "required": ["message", "issues"]
      },
      "ValidationIssue": {
        "type": "object",
        "properties": {
          "path": {
            "type": "string"
          },
          "message": {
            "type": "string"
          }
        },
        "required": ["path", "message"]
      },
      "AuthRequest": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "format": "email",
            "example": "user@example.com"
          },
          "password": {
            "type": "string",
            "minLength": 8,
            "example": "password"
          }
        },
        "required": ["email", "password"]
      },
      "LoggedOutResponse": {
        "type": "object",
        "properties": {
          "authenticated": {
            "type": "boolean",
            "enum": [false]
          }
        },
        "required": ["authenticated"]
      },
      "ExpenseSummaryResponse": {
        "type": "object",
        "properties": {
          "data": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ExpenseSummary"
            }
          },
          "meta": {
            "$ref": "#/components/schemas/ExpenseSummaryMeta"
          }
        },
        "required": ["data", "meta"]
      },
      "ExpenseSummary": {
        "type": "object",
        "properties": {
          "total_amount": {
            "type": "number"
          },
          "total_point": {
            "type": "number"
          },
          "net_amount": {
            "type": "number"
          },
          "transaction_count": {
            "type": "integer",
            "minimum": 0
          },
          "category_id": {
            "type": "string"
          },
          "category_name": {
            "type": "string"
          },
          "payment_method_id": {
            "type": "string"
          },
          "payment_method_name": {
            "type": "string"
          },
          "initial_balance": {
            "type": "number"
          },
          "remaining_balance": {
            "type": "number"
          },
          "date": {
            "type": "string",
            "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
            "example": "2026-07-20"
          }
        },
        "required": ["total_amount", "total_point", "net_amount", "transaction_count"]
      },
      "ExpenseSummaryMeta": {
        "type": "object",
        "properties": {
          "total_net_amount": {
            "type": "number"
          },
          "fixed_cost_net_amount": {
            "type": "number"
          },
          "fixed_costs": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/FixedCost"
            }
          }
        },
        "required": ["total_net_amount", "fixed_costs"]
      },
      "FixedCost": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "payment_date": {
            "type": "string",
            "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
            "example": "2026-07-20"
          },
          "amount": {
            "type": "number"
          }
        },
        "required": ["name", "payment_date", "amount"]
      },
      "BadRequestResponse": {
        "anyOf": [
          {
            "$ref": "#/components/schemas/ValidationErrorResponse"
          },
          {
            "$ref": "#/components/schemas/ErrorResponse"
          }
        ]
      },
      "ExpenseGroupBy": {
        "type": "string",
        "enum": ["category", "payment_method", "date"],
        "default": "category"
      },
      "ExpenseHistoryResponse": {
        "type": "array",
        "items": {
          "$ref": "#/components/schemas/ExpenseHistory"
        }
      },
      "ExpenseHistory": {
        "type": "object",
        "properties": {
          "net_amount": {
            "type": "number"
          },
          "memo": {
            "type": "string",
            "nullable": true
          },
          "date": {
            "type": "string",
            "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
            "example": "2026-07-20"
          }
        },
        "required": ["net_amount", "memo", "date"]
      },
      "ExpenseCreatedResponse": {
        "type": "object",
        "properties": {
          "created": {
            "type": "boolean",
            "enum": [true]
          }
        },
        "required": ["created"]
      },
      "ExpenseCreateRequest": {
        "type": "object",
        "properties": {
          "amount": {
            "type": "integer",
            "minimum": 0
          },
          "point_amount": {
            "type": "integer",
            "minimum": 0
          },
          "payment_method_id": {
            "type": "string",
            "minLength": 1
          },
          "category_id": {
            "type": "string",
            "minLength": 1
          },
          "memo": {
            "type": "string",
            "maxLength": 255
          },
          "date": {
            "type": "string",
            "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
            "example": "2026-07-20"
          }
        },
        "required": ["amount", "point_amount", "payment_method_id", "category_id", "memo", "date"]
      },
      "ExpensePaymentMethodList": {
        "type": "array",
        "items": {
          "$ref": "#/components/schemas/ExpensePaymentMethod"
        }
      },
      "ExpensePaymentMethod": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          }
        },
        "required": ["id", "name"]
      },
      "ExpenseCategoryList": {
        "type": "array",
        "items": {
          "$ref": "#/components/schemas/ExpenseCategory"
        }
      },
      "ExpenseCategory": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          }
        },
        "required": ["id", "name"]
      }
    },
    "parameters": {}
  },
  "paths": {
    "/health": {
      "get": {
        "tags": ["System"],
        "summary": "Check BFF health",
        "responses": {
          "200": {
            "description": "The BFF is healthy.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse"
                }
              }
            }
          }
        }
      }
    },
    "/auth/login": {
      "get": {
        "tags": ["Authentication"],
        "summary": "Start the authorization code login flow",
        "responses": {
          "302": {
            "description": "Redirect to the authentication server.",
            "headers": {
              "Location": {
                "description": "Redirect destination.",
                "schema": {
                  "type": "string",
                  "format": "uri"
                }
              }
            }
          },
          "502": {
            "description": "A retry page is shown when the authorization flow cannot be started.",
            "content": {
              "text/html": {
                "schema": {
                  "type": "string"
                }
              }
            }
          }
        }
      },
      "post": {
        "tags": ["Authentication"],
        "summary": "Log in and create a browser session",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AuthRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Login succeeded.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AuthenticatedResponse"
                }
              }
            }
          },
          "400": {
            "description": "Request validation failed.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ValidationErrorResponse"
                }
              }
            }
          },
          "401": {
            "description": "The credentials are invalid.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "502": {
            "description": "The authentication service is unavailable or returned an invalid response.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/auth/callback": {
      "get": {
        "tags": ["Authentication"],
        "summary": "Complete the authorization code login flow",
        "parameters": [
          {
            "schema": {
              "type": "string",
              "minLength": 1
            },
            "required": true,
            "name": "code",
            "in": "query"
          },
          {
            "schema": {
              "type": "string",
              "minLength": 1
            },
            "required": true,
            "name": "state",
            "in": "query"
          }
        ],
        "responses": {
          "302": {
            "description": "Login succeeded and the browser returns to the frontend.",
            "headers": {
              "Location": {
                "description": "Redirect destination.",
                "schema": {
                  "type": "string",
                  "format": "uri"
                }
              }
            }
          },
          "400": {
            "description": "A retry page is shown for an invalid or expired authorization response.",
            "content": {
              "text/html": {
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "502": {
            "description": "A retry page is shown when the authentication service cannot complete the login.",
            "content": {
              "text/html": {
                "schema": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    },
    "/auth/session": {
      "get": {
        "tags": ["Authentication"],
        "summary": "Check the browser session",
        "security": [
          {
            "SessionCookie": []
          }
        ],
        "responses": {
          "200": {
            "description": "The browser session is authenticated.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AuthenticatedResponse"
                }
              }
            }
          },
          "401": {
            "description": "The browser session is missing or expired.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/auth/register": {
      "post": {
        "tags": ["Authentication"],
        "summary": "Register and create a browser session",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AuthRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Registration succeeded.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AuthenticatedResponse"
                }
              }
            }
          },
          "400": {
            "description": "Request validation failed.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ValidationErrorResponse"
                }
              }
            }
          },
          "409": {
            "description": "The email address is already registered.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "502": {
            "description": "The authentication service is unavailable or returned an invalid response.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/auth/refresh": {
      "post": {
        "tags": ["Authentication"],
        "summary": "Refresh the server-side access token",
        "security": [
          {
            "SessionCookie": []
          }
        ],
        "responses": {
          "200": {
            "description": "The token was refreshed.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AuthenticatedResponse"
                }
              }
            }
          },
          "401": {
            "description": "The session could not be refreshed.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/auth/logout": {
      "post": {
        "tags": ["Authentication"],
        "summary": "Delete the browser session",
        "responses": {
          "200": {
            "description": "Logout completed.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/LoggedOutResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/expenses/summary": {
      "get": {
        "tags": ["Expenses"],
        "summary": "Get an expense summary",
        "security": [
          {
            "SessionCookie": []
          }
        ],
        "parameters": [
          {
            "schema": {
              "type": "string",
              "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
              "example": "2026-07-20"
            },
            "required": true,
            "name": "start_date",
            "in": "query"
          },
          {
            "schema": {
              "type": "string",
              "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
              "example": "2026-07-20"
            },
            "required": true,
            "name": "end_date",
            "in": "query"
          },
          {
            "schema": {
              "$ref": "#/components/schemas/ExpenseGroupBy"
            },
            "required": false,
            "name": "group_by",
            "in": "query"
          }
        ],
        "responses": {
          "200": {
            "description": "Expense summary.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ExpenseSummaryResponse"
                }
              }
            }
          },
          "400": {
            "description": "The request is invalid.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/BadRequestResponse"
                }
              }
            }
          },
          "401": {
            "description": "The browser session is missing or expired.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "422": {
            "description": "The backend rejected the request.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "502": {
            "description": "The backend is unavailable or violated the BFF response contract.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/expenses/history": {
      "get": {
        "tags": ["Expenses"],
        "summary": "Get expense history for a category",
        "security": [
          {
            "SessionCookie": []
          }
        ],
        "parameters": [
          {
            "schema": {
              "type": "string",
              "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
              "example": "2026-07-20"
            },
            "required": true,
            "name": "start_date",
            "in": "query"
          },
          {
            "schema": {
              "type": "string",
              "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
              "example": "2026-07-20"
            },
            "required": true,
            "name": "end_date",
            "in": "query"
          },
          {
            "schema": {
              "type": "string",
              "minLength": 1
            },
            "required": true,
            "name": "category_id",
            "in": "query"
          }
        ],
        "responses": {
          "200": {
            "description": "Expense history.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ExpenseHistoryResponse"
                }
              }
            }
          },
          "400": {
            "description": "The request is invalid.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/BadRequestResponse"
                }
              }
            }
          },
          "401": {
            "description": "The browser session is missing or expired.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "422": {
            "description": "The backend rejected the request.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "502": {
            "description": "The backend is unavailable or violated the BFF response contract.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/expenses": {
      "post": {
        "tags": ["Expenses"],
        "summary": "Create an expense",
        "security": [
          {
            "SessionCookie": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ExpenseCreateRequest"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "The expense was created.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ExpenseCreatedResponse"
                }
              }
            }
          },
          "400": {
            "description": "The request is invalid.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/BadRequestResponse"
                }
              }
            }
          },
          "401": {
            "description": "The browser session is missing or expired.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "422": {
            "description": "The backend rejected the request.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "502": {
            "description": "The backend is unavailable or violated the BFF response contract.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/payment-methods": {
      "get": {
        "tags": ["Expense masters"],
        "summary": "List active payment methods",
        "security": [
          {
            "SessionCookie": []
          }
        ],
        "responses": {
          "200": {
            "description": "Active payment methods.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ExpensePaymentMethodList"
                }
              }
            }
          },
          "400": {
            "description": "The request is invalid.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/BadRequestResponse"
                }
              }
            }
          },
          "401": {
            "description": "The browser session is missing or expired.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "422": {
            "description": "The backend rejected the request.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "502": {
            "description": "The backend is unavailable or violated the BFF response contract.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/categories": {
      "get": {
        "tags": ["Expense masters"],
        "summary": "List active expense categories",
        "security": [
          {
            "SessionCookie": []
          }
        ],
        "responses": {
          "200": {
            "description": "Active expense categories.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ExpenseCategoryList"
                }
              }
            }
          },
          "400": {
            "description": "The request is invalid.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/BadRequestResponse"
                }
              }
            }
          },
          "401": {
            "description": "The browser session is missing or expired.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "422": {
            "description": "The backend rejected the request.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "502": {
            "description": "The backend is unavailable or violated the BFF response contract.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    }
  }
}
